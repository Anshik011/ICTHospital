# ==============================================================================
# ICTHospital - Shared Hosting Production Environment Configuration
# ==============================================================================
# Copy this file to .env on your shared hosting server (Hostinger, cPanel, Plesk):
# cp .env.shared-hosting.example .env
#
# Then update:
# 1. APP_KEY (generate via 'php artisan key:generate' or paste an existing 32-char base64 key)
# 2. APP_URL (your live domain, e.g. https://yourhospital.com)
# 3. Database credentials (DB_DATABASE, DB_USERNAME, DB_PASSWORD from your hosting panel)
# 4. Mail credentials (SMTP settings from your hosting email account)
# ==============================================================================

APP_NAME="Uptoware Clinic"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourhospital.com
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Maintenance mode settings
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# Logging Configuration
# Daily log rotation prevents a single monolithic log file from filling shared disk quota
# ------------------------------------------------------------------------------
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# Database Configuration (MySQL / MariaDB on Shared Hosting)
# Note: In Hostinger/cPanel, DB name and user typically start with your account prefix
# e.g., u123456789_icthospital
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_hosting_database
DB_USERNAME=your_hosting_username
DB_PASSWORD="your_strong_password"

# ------------------------------------------------------------------------------
# Session Configuration
# Database session driver is recommended for persistence across shared hosting restarts
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# ------------------------------------------------------------------------------
# Cache & Filesystem
# File cache is ideal for shared hosting where Redis/Memcached are unavailable
# ------------------------------------------------------------------------------
CACHE_STORE=file
CACHE_PREFIX=icthospital_cache

FILESYSTEM_DISK=public

# ------------------------------------------------------------------------------
# Queue Configuration
# MUST be 'sync' on shared hosting because background queue worker daemons (supervisor)
# are not available on shared hosting environments.
# ------------------------------------------------------------------------------
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

# ------------------------------------------------------------------------------
# Mail Configuration (Hostinger / cPanel SMTP)
# Hostinger SMTP Default: smtp.hostinger.com (Port 465 with SSL, or 587 with TLS)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=noreply@yourhospital.com
MAIL_PASSWORD="your_email_password"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@yourhospital.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Laravel Logger Configuration
# ------------------------------------------------------------------------------
LARAVEL_LOGGER_USER_MODEL=App\Models\User

# ------------------------------------------------------------------------------
# Optional: Setup Helper Secret Key
# If you use public/install-helper.php to run migrations via the browser,
# set a random secret token here for authentication.
# ------------------------------------------------------------------------------
INSTALL_HELPER_KEY=
